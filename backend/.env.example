BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# REGION=eu                      # eu, us, kr or tw
# FOREVER_RULESETS=pvp           # Forever rulesets to track: pvp, normal, roleplay, rp-pvp (each adds ~20k rows per hour)
# LIVE_RATES=on                  # read the cut and deposit rates from the game's client tables (wago.tools); off = use the values below
# NOTIFICATIONS=on               # a macOS notification when new prices reach the database; off to disable
# RATES_INTERVAL=24h             # how often to re-check them (min 1h)
# AH_CUT_PERCENT=5               # fallback cut of the Alliance and Horde houses
# AH_CUT_BLACKWATER_PERCENT=15   # fallback cut of the cross-faction Blackwater house
# RETENTION_DAYS=30              # max 30 (Blizzard API terms)
# POLL_INTERVAL=1m               # the slowest polling rhythm; it speeds up by itself around Blizzard's hourly publication
